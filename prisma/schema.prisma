generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  recipes   Recipe[]
  createdAt DateTime @default(now())
}

model Recipe {
  id          String   @id @default(cuid())
  title       String
  ingredients String?
  steps       String?
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id])
  createdAt   DateTime @default(now())
}
